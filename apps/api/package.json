{
  "name": "@darp/api",
  "version": "1.0.0",
  "description": "DARP backend tier: the Express API. The only process that holds database credentials and encryption keys.",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local src/server/db/migrate.ts",
    "db:harden": "tsx --env-file=.env.local scripts/harden-db.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:seed:demo": "tsx --env-file=.env.local scripts/seed-demo.ts",
    "db:reset": "tsx --env-file=.env.local scripts/reset.ts",
    "db:setup": "npm run db:migrate && npm run db:harden && npm run db:seed",
    "journals:import": "tsx --env-file=.env.local scripts/import-journals.ts"
  },
  "dependencies": {
    "@darp/shared": "*",
    "@node-rs/argon2": "^2.0.2",
    "@vercel/blob": "^2.8.1",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@vitest/coverage-v8": "^5.0.3",
    "dotenv": "^17.2.2",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.36.0",
    "eslint-plugin-security": "^3.0.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^5.0.3"
  }
}
