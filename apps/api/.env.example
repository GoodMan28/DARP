# DARP API (apps/api). Copy to apps/api/.env.local for local development.
# This is the only tier that holds database credentials and encryption keys — the web tier
# (apps/web) never sees any of the values below.

# ---- Database ----
# The application connects as the least-privilege user (no DDL rights).
DATABASE_URL="postgresql://darp_app:CHANGE_ME@localhost:5432/darp"
# Migrations and hardening run as the owner. Never used by the running app.
DATABASE_URL_OWNER="postgresql://darp_owner:CHANGE_ME@localhost:5432/darp"
# Password given to the darp_app role by scripts/harden-db.ts
APP_DB_PASSWORD="CHANGE_ME"

# ---- Crypto (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))") ----
# 32 raw bytes, base64. Encrypts Aadhaar/PAN at rest. Losing it makes those fields unreadable.
PII_ENCRYPTION_KEY=""
# Separate 32-byte key used to sign session ids and CSRF tokens.
SESSION_SECRET=""

# ---- App ----
# The exact origin users type into the browser — the WEB tier's address, not the API's.
# Every unsafe request's Origin header must match it (CSRF protection).
APP_URL="http://localhost:3000"
NODE_ENV="development"
MAX_UPLOAD_MB="5"

# ---- Network ----
PORT="4000"
# Loopback by default: only the web tier on this machine can reach the API. Set "0.0.0.0"
# inside a container so the web container can reach it over the private network.
HOST="127.0.0.1"
# Which proxies are believed when they report the client's IP in X-Forwarded-For.
# Default (blank): loopback and private-network addresses — the web tier and a reverse proxy
# on the same host or private network. Accepts Express "trust proxy" values.
TRUST_PROXY=""

# ---- Evidence storage ----
# "local" (default): files on disk at EVIDENCE_DIR. Works anywhere with a persistent filesystem.
# "blob": Vercel Blob. REQUIRED on Vercel — serverless functions there have no persistent disk,
#   so anything written to EVIDENCE_DIR would vanish between requests. BLOB_READ_WRITE_TOKEN is
#   injected automatically once a Blob store is linked to the Vercel project; nothing to set by hand.
STORAGE_DRIVER="local"
EVIDENCE_DIR="./storage/evidence"        # only used when STORAGE_DRIVER=local; absolute path in production

# ---- Email (password resets). Leave blank in dev: tokens are printed to the server log. ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="iqac@bitmesra.ac.in"

# ---- Session policy (minutes) ----
SESSION_IDLE_MINUTES="30"
SESSION_ABSOLUTE_MINUTES="480"

# ---- Seed (used once by scripts/seed.ts to create the first IQAC administrator) ----
SEED_ADMIN_EMAIL="iqac@bitmesra.ac.in"
SEED_ADMIN_PASSWORD=""
